NODE_ENV=development
API_PORT=3333
LOG_LEVEL=info

PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_ADMIN_URL=http://localhost:5173

# --- Supabase (local: from `supabase status` after `supabase start`) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

REDIS_URL=redis://localhost:6379

# 32 random bytes, base64-encoded — e.g. `openssl rand -base64 32`
# Encrypts instagram_sources.access_token_cipher. Never reuse across envs.
SECRETS_ENCRYPTION_KEY=

# --- Meta / Instagram (Sprint 4+) ---
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=http://localhost:3333/instagram/oauth/callback
META_GRAPH_VERSION=v21.0

# --- Email (Sprint 9). MAIL_DRIVER=noop logs instead of sending. ---
MAIL_DRIVER=noop
MAIL_API_KEY=
MAIL_FROM="Portal <no-reply@portal.com.br>"

# --- AI classification (Sprint 6). AI_PROVIDER=noop disables classification. ---
AI_PROVIDER=noop
AI_API_KEY=

SENTRY_DSN=
