{
  "name": "mozar-alerta-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "dev:scheduler": "tsx watch src/scheduler.ts",
    "build:packages": "pnpm --filter @mozar/types --filter @mozar/db build",
    "build": "pnpm build:packages && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "pnpm build:packages && tsc --noEmit",
    "test": "pnpm build:packages && vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @mozar/db generate",
    "db:migrate": "pnpm --filter @mozar/db migrate",
    "db:studio": "pnpm --filter @mozar/db studio",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@mozar/db": "workspace:*",
    "@mozar/types": "workspace:*",
    "@supabase/supabase-js": "^2.47.10",
    "bullmq": "^5.34.4",
    "drizzle-orm": "^0.38.2",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.4.2",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "sanitize-html": "^2.13.1",
    "sharp": "^0.33.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/sanitize-html": "^2.13.0",
    "eslint": "^9.17.0",
    "@eslint/js": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "typescript-eslint": "^8.19.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,js}": ["prettier --write"]
  }
}
